# Runtime артефакты (не коммитятся)
/.claude/scheduled_tasks.lock
ai/openclaw/pending-events/*.json
ai/.spark/
ai/.council/

# Личная инфраструктура — отдельный приватный репо EllevatedAI/infra
# (DLD публичный, серверы и VPN-документы туда не попадают)
/infra/

# Harvested golden datasets — NEVER commit (DLD is a PUBLIC repo)
# scripts/harvest-goldens.py mines subagent transcripts from
# ~/.claude/projects/*/subagents/, so its output carries verbatim source code,
# specs and paths from whatever projects were run locally — AwardyBot, Dowry,
# PLPilot, RIS/MeMyselfAndI. The tool is public; its output is not.
# Curate a pair by hand into test/agents/<agent>/ before it goes anywhere.
test/agents-harvested/

# Бэкапы БД оркестратора на VPS
scripts/vps/orchestrator.db.bak-*
