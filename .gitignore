# Локальные настройки Claude Code (не коммитить permissions)
/.claude/settings.local.json
/.claude/worktrees/


# Системные файлы macOS
.DS_Store
**/.DS_Store

# Временные файлы
*.tmp
*.swp
*~
.*.swp

# IDE
.idea/
.vscode/
*.code-workspace

# Логи
*.log
.worktrees/

# Локальные бизнес-доки
/biz/
/brandbook/

# Сгенерированные артефакты
*.html

# Python
__pycache__/
*.pyc
venv/
.venv/

# Локальные базы и секреты VPS-оркестратора
scripts/vps/.env
scripts/vps/*.db
scripts/vps/.notified-drafts-*
scripts/vps/.task-cmd-*.txt
scripts/vps/.orchestrator.pid
scripts/vps/.orchestrator-heartbeat
scripts/vps/.gate-daemon.pid
scripts/vps/.gate-daemon-heartbeat
scripts/vps/callback-audit.jsonl
scripts/vps/ai/

# Runtime артефакты (не коммитятся)
/.claude/scheduled_tasks.lock
ai/openclaw/pending-events/*.json
ai/.spark/
ai/.council/

# Личная инфраструктура — отдельный приватный репо EllevatedAI/infra
