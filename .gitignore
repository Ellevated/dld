# Локальные настройки Claude Code (не коммитить permissions)
/.claude/settings.local.json
/.claude/worktrees/


# Системные файлы macOS
.DS_Store
**/.DS_Store

# Временные файлы
*.tmp
*.swp
*~
.*.swp

# IDE
.idea/
.vscode/
*.code-workspace

# Логи
*.log
.worktrees/

